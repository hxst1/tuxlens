    # -- events -----------------------------------------------------------------------------
    def on_key(self, _ctrl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.quit()
            return True
        return False

    def on_backdrop_click(self, _gesture, _n, x, y, backdrop):
        if backdrop.pick(x, y, Gtk.PickFlags.DEFAULT) is backdrop:
            self.quit()

    def set(self, changes: dict) -> None:
        if self._updating:
            return
        api_async("POST", "/settings", changes, lambda _r: self.refresh() and False)

    def on_zoom(self, scale):
        self.zoom_value.set_text(f"{scale.get_value():.1f}×")
        if self._updating:
            return
        if self._zoom_timer:
            GLib.source_remove(self._zoom_timer)
        # Debounce: the phone re-applies constraints on each change.
        self._zoom_timer = GLib.timeout_add(120, self._send_zoom)

    def _send_zoom(self):
        self._zoom_timer = 0
        key = "digital_zoom" if self.is_local() else "zoom"
        self.set({key: round(self.zoom.get_value(), 2)})
        return False

    def is_local(self) -> bool:
        return ((self.status or {}).get("settings") or {}).get("source", "phone") != "phone"

    def on_source(self, drop, _pspec):
        if self._updating:
            return
        idx = drop.get_selected()
        if 0 <= idx < len(self.source_ids):
            self.set({"source": self.source_ids[idx]})

    def show_sources(self, sources: list[dict], current: str) -> None:
        ids = [src["id"] for src in sources]
        names = []
        for src in sources:
            name = src["name"]
            if src["kind"] == "phone" and not src.get("connected"):
                name += f" ({S['not_connected']})"
            names.append(name)
        if ids != self.source_ids or names != [self.source_model.get_string(i) for i in range(self.source_model.get_n_items())]:
            self.source_ids = ids
            self.source_model.splice(0, self.source_model.get_n_items(), names)
        if current in ids:
            self.source_drop.set_selected(ids.index(current))

    # -- local camera controls (built from what the camera offers) ---------------------------
    def load_camera_controls(self, force: bool = False) -> None:
        def show(data):
            self._updating = True
            try:
                self.build_camera_controls((data or {}).get("controls") or [])
            finally:
                self._updating = False
            return False
        api_async("GET", "/camera/controls", None, show)

    def build_camera_controls(self, controls: list[dict]) -> None:
        box = self.camctl_box
        while (child := box.get_first_child()) is not None:
            box.remove(child)
        for c in controls:
            row = Gtk.Box(spacing=10)
            row.add_css_class("row")
            row.append(label(S["ctl"].get(c["name"], c["name"]), "muted" if c["type"] == "int" else None, ellipsize=True))
            if c["type"] == "bool":
                w = Gtk.Switch(valign=Gtk.Align.CENTER, active=bool(c.get("value")))
                w.connect("state-set", lambda _w, on, n=c["name"]: (self.set_control(n, int(on)), False)[1])
            elif c["type"] == "menu":
                opts = c.get("options") or []
                w = Gtk.DropDown.new_from_strings([S["menu"].get(o["label"], o["label"]) for o in opts])
                values = [o["value"] for o in opts]
                if c.get("value") in values:
                    w.set_selected(values.index(c["value"]))
                w.connect("notify::selected", lambda d, _p, n=c["name"], v=values:
                          self.set_control(n, v[d.get_selected()]) if 0 <= d.get_selected() < len(v) else None)
            else:
                lo, hi = c.get("min", 0), c.get("max", 100)
                w = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, max(1, c.get("step", 1)))
                w.set_draw_value(False)
                w.set_hexpand(True)
                w.set_value(c.get("value", lo))
                if "default" in c:
                    w.add_mark(c["default"], Gtk.PositionType.BOTTOM, None)
                w.connect("value-changed", lambda sc, n=c["name"]: self.debounce_control(n, round(sc.get_value())))
            w.set_sensitive(not c.get("inactive"))
            row.append(w)
            box.append(row)

    def debounce_control(self, name: str, value: int) -> None:
        if self._updating:
            return
        timers = self.__dict__.setdefault("_ctl_timers", {})
        if timers.get(name):
            GLib.source_remove(timers[name])
        timers[name] = GLib.timeout_add(120, lambda: (timers.pop(name, None), self.set_control(name, value), False)[2])

    def set_control(self, name: str, value: int) -> None:
        if self._updating:
            return
        # Re-read afterwards: some controls enable others (manual exposure → exposure time).
        api_async("POST", "/camera/controls", {name: value},
                  lambda data: (self._updating_build(data), False)[1])

    def _updating_build(self, data):
        self._updating = True
        try:
            self.build_camera_controls((data or {}).get("controls") or [])
        finally:
            self._updating = False

    def on_mode(self, key):
        self.set({"capture": "720p", "fps": 60} if key == "fast" else {"capture": "1080p", "fps": 30})

    def rotate(self, delta):
        current = (self.status or {}).get("settings", {}).get("rotate", 0)
        self.set({"rotate": (current + delta) % 360})

    def on_theme(self, drop, _pspec):
        if self._updating:
            return
        idx = drop.get_selected()
        if 0 <= idx < len(self.theme_names):
            theme_id = self.theme_names[idx]
            self.apply_theme(theme_id)
            self.set({"theme": theme_id})

    def toggle_pair(self):
        if self.pair_box.get_visible():
            self.pair_box.set_visible(False)
            return

        def show(urls):
            if not urls:
                return False
            self.pair_url.set_text(urls["setup"])
            png = None
            if shutil.which("qrencode"):
                png = subprocess.run(["qrencode", "-o", "-", "-t", "PNG", "-s", "4", "-m", "1", urls["setup"]],
                                     capture_output=True).stdout
            if png:
                self.qr.set_paintable(Gdk.Texture.new_from_bytes(GLib.Bytes.new(png)))
                self.qr.set_visible(True)
            else:
                self.qr.set_visible(False)
            self.pair_box.set_visible(True)
            return False
        api_async("GET", "/pair", None, show)

    # -- state ------------------------------------------------------------------------------
    def refresh(self):
        if self.window is None:
            return False
        api_async("GET", "/status", None, self.update)
        return True

    def update(self, st):
        self._updating = True
        try:
            self._update(st)
        finally:
            self._updating = False
        return False

    def show_requests(self, requests: list[dict]) -> None:
        key = tuple(r["id"] for r in requests)
        if key == self._requests_key:
            return
        self._requests_key = key
        while (child := self.requests_box.get_first_child()) is not None:
            self.requests_box.remove(child)
        for req in requests:
            row = Gtk.Box(spacing=8)
            row.add_css_class("request")
            row.append(label(S["wants"].format(name=req["name"], address=req["address"]), ellipsize=True))
            for text, approve in ((S["reject"], False), (S["accept"], True)):
                b = Gtk.Button(label=text)
                b.add_css_class("chip")
                if approve:
                    b.add_css_class("active")
                b.connect("clicked", lambda _b, i=req["id"], a=approve:
                          api_async("POST", "/pair/decide", {"id": i, "approve": a}, lambda _r: self.refresh() and False))
                row.append(b)
            self.requests_box.append(row)
        self.requests_box.set_visible(bool(requests))

    def _update(self, st):
        self.status = st
        self.show_requests((st or {}).get("pair_requests") or [])
        for cls in ("live", "error", "connected", "holding"):
            self.dot.remove_css_class(cls)
        if st is None:
            self.subtitle.set_text(S["off"])
            self.footer_note.set_text(S["start_hint"])
            self.dot.add_css_class("error")
            self.card_set_sensitive(False)
            return
        self.footer_note.set_text("")
        self.card_set_sensitive(True)
        s = st["settings"]
        phone = st["phone"]
        stats = st["stats"]
        state = st["state"]
        local_err = (st.get("local") or {}).get("error")
        if local_err == "busy" and state not in ("live", "holding"):
            self.subtitle.set_text(S["busy"])
            self.dot.add_css_class("error")
        elif state == "error":
            self.subtitle.set_text(f"{S['error']}: {st.get('error')}")
            self.dot.add_css_class("error")
        elif state in ("live", "holding"):
            total = stats["stages_ms"]["total"]["p50"]
            name = phone.get("label") or s["camera"]
            if s.get("source", "phone") != "phone":
                name = next((src["name"] for src in st.get("sources") or [] if src["id"] == s["source"]), s["source"])
            self.subtitle.set_text(f"{S[state]} · {name}")
            self.dot.add_css_class(state)
            ph = stats.get("phone") or {}
            src = st.get("source", "")
            self.stats.set_text(f"{stats['fps_out']:.0f} fps · {S['latency']} {total:.0f} ms · "
                                f"{(ph.get('kbps') or 0) / 1000:.1f} Mbps · {src.split(' ')[0]}")
        elif not (st.get("camera") or {}).get("enabled", True):
            self.subtitle.set_text(S["camera_off"])
        elif not (st.get("camera") or {}).get("active", True):
            self.subtitle.set_text(S["ready"])
        elif phone.get("connected"):
            self.subtitle.set_text(S["connected"])
            self.dot.add_css_class("connected")
        else:
            self.subtitle.set_text(S["idle"])
        if state not in ("live", "holding"):
            self.stats.set_text("")

        cam = st.get("camera") or {}
        self.camera_switch.set_active(bool(cam.get("enabled", True)))
        self.on_demand.set_active(bool(cam.get("on_demand", True)))
        self.preview_empty.set_text(S["camera_off"] if not cam.get("enabled", True) else S["no_preview"])
        local = s.get("source", "phone") != "phone"
        self.show_sources(st.get("sources") or [], s.get("source", "phone"))
        available = set(phone.get("available") or []) or None
        self.cameras.set_available(set() if local else available)
        self.cameras.set_active(None if local else s["camera"])
        self.sections["camctl"].set_visible(local)
        if local and self.camctl_key != s["source"]:
            self.camctl_key = s["source"]
            self.load_camera_controls()
        elif not local:
            self.camctl_key = None

        if local:      # digital zoom (crop) for cameras without optical zoom
            self.zoom.set_range(1.0, 4.0)
            self.zoom.set_value(float(s.get("digital_zoom", 1.0)))
            self.zoom_value.set_text(f"{float(s.get('digital_zoom', 1.0)):.1f}×")
        else:
            zoom = phone.get("zoom") or {}
            lo, hi = float(zoom.get("min") or 1), float(zoom.get("max") or 10)
            self.zoom.set_range(lo, max(lo + 0.1, min(hi, 10.0)))
            self.zoom.set_value(float(s["zoom"]))
            self.zoom_value.set_text(f"{float(s['zoom']):.1f}×")
        self.torch.set_sensitive(not local and bool(phone.get("torch", True)))
        self.torch.set_active(bool(s["torch"]))

        fast = s.get("capture") == "720p" or (s.get("fps", 30) >= 50)
        self.mode.set_active("fast" if fast else "sharp")
        extra = s.get("rotate", 0)
        auto = phone.get("rotation")
        self.rot_label.set_text(S["auto"] + (f" {auto}°" if auto is not None else "") + (f" {extra:+d}°" if extra else ""))
        self.mirror.set_active(bool(s.get("mirror")))

        self.mic.set_active(bool(s.get("mic")))
        for w in self.audio_controls:
            w.set_sensitive(bool(s.get("mic")))
        self.gain.set_value(float(s.get("mic_gain_db", 0)))
        for key, sw in self.audio_switches.items():
            sw.set_active(bool(s.get(key, key != "mic_mute")))
        mic = st.get("mic") or {}
        if mic.get("error"):
            self.mic_hint.set_text(mic["error"])
        elif mic.get("streaming"):
            self.mic_hint.set_text(f"{S['mic_live']} · {mic.get('backlog_ms', 0):.0f} ms")
        else:
            self.mic_hint.set_text(S["mic_hint"])
        self.background.set_active(s.get("effect", "none"))
        self.strength_row.set_visible(s.get("effect") == "blur")
        self.strength.set_value(float(s.get("blur_strength", 0.6)))
        self.image_row.set_visible(s.get("effect") == "image")
        img = s.get("background_image") or ""
        self.image_name.set_text(os.path.basename(img) if img else S["no_image"])
        self.framing.set_active(bool(s.get("framing")))
        if s.get("filter") in self.filter_keys:
            self.filter_drop.set_selected(self.filter_keys.index(s["filter"]))

        if s["theme"] in self.theme_names:
            self.theme_drop.set_selected(self.theme_names.index(s["theme"]))
            self.apply_theme(s["theme"])

    UI_STATE = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "tuxlens" / "panel.json"

    def section(self, parent: Gtk.Box, title: str, key: str, default_open: bool) -> Gtk.Box:
        """Collapsible section; remembers whether it was left open."""
        if not hasattr(self, "sections"):
            self.sections = {}
            try:
                self._ui_state = json.loads(self.UI_STATE.read_text())
            except (OSError, ValueError):
                self._ui_state = {}
        exp = Gtk.Expander(label=title, expanded=self._ui_state.get(key, default_open))
        exp.add_css_class("section-exp")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=4)
        exp.set_child(box)
        exp.connect("notify::expanded", lambda e, _p, k=key: self._save_section(k, e.get_expanded()))
        parent.append(exp)
        self.sections[key] = exp
        return box

    def _save_section(self, key: str, expanded: bool) -> None:
        self._ui_state[key] = expanded
        try:
            self.UI_STATE.parent.mkdir(parents=True, exist_ok=True)
            self.UI_STATE.write_text(json.dumps(self._ui_state))
        except OSError:
            pass

    def max_body_height(self) -> int:
        """Shortest monitor minus the bar offset and the header, so the card never runs off screen."""
        heights = []
        monitors = Gdk.Display.get_default().get_monitors()
        for i in range(monitors.get_n_items()):
            heights.append(monitors.get_item(i).get_geometry().height)
        top = int(os.environ.get("TUXLENS_PANEL_TOP", "48"))
        return max(320, (min(heights) if heights else 900) - top - 150)

    def on_gain(self, scale):
        value = round(scale.get_value())
        self.gain_value.set_text(f"{value:+d} dB" if value else "0 dB")
        if self._updating:
            return
        if getattr(self, "_gain_timer", 0):
            GLib.source_remove(self._gain_timer)
        self._gain_timer = GLib.timeout_add(100, lambda: (self.set({"mic_gain_db": value}),
                                                          setattr(self, "_gain_timer", 0), False)[2])

    def poll_level(self):
        if self.window is None:
            return False
        if not self.sections["audio"].get_expanded():
            return True

        def show(data):
            if data and data.get("streaming"):
                db = max(-60.0, min(0.0, data["level_db"]))
                self.level.set_value(db + 60)
                self.level_value.set_text(f"{db:.0f} dB")
            else:
                self.level.set_value(0)
                self.level_value.set_text("—")
            return False
        api_async("GET", "/mic/level", None, show)
        return True

    def has_image(self) -> bool:
        path = ((self.status or {}).get("settings") or {}).get("background_image")
        return bool(path) and os.path.exists(path)

    def choose_image(self):
        """The file chooser is a normal window: hide the overlay panel while it is open."""
        dialog = Gtk.FileDialog(title=S["choose"], modal=False)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        flt = Gtk.FileFilter()
        flt.set_name(S["images"])
        flt.add_mime_type("image/*")
        filters.append(flt)
        dialog.set_filters(filters)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        if pictures:
            dialog.set_initial_folder(Gio.File.new_for_path(pictures))
        self.window.set_visible(False)

        def done(dlg, result):
            try:
                gfile = dlg.open_finish(result)
            except GLib.Error:
                gfile = None
            self.window.set_visible(True)
            if gfile is not None and gfile.get_path():
                self.set({"effect": "image", "background_image": gfile.get_path()})
        dialog.open(None, None, done)

    def on_strength(self, scale):
        if self._updating:
            return
        if getattr(self, "_strength_timer", 0):
            GLib.source_remove(self._strength_timer)
        self._strength_timer = GLib.timeout_add(120, lambda: (self.set({"blur_strength": round(scale.get_value(), 2)}),
                                                              setattr(self, "_strength_timer", 0), False)[2])

    def on_filter(self, drop, _pspec):
        if self._updating:
            return
        idx = drop.get_selected()
        if 0 <= idx < len(self.filter_keys):
            self.set({"filter": self.filter_keys[idx]})

    def card_set_sensitive(self, on: bool):
        for w in (self.cameras, self.zoom, self.torch, self.mode, self.mirror):
            w.set_sensitive(on)

    # -- preview ----------------------------------------------------------------------------
    def preview_loop(self):
        import time
        # Logical size on purpose: a bigger texture would raise the picture's natural width.
        width = self.PREVIEW_W
        while self._preview_running:
            started = time.monotonic()
            try:
                status, headers, data = api("GET", f"/preview?w={width & ~1}", raw=True)
            except OSError:
                status, headers, data = 0, {}, b""
            if status == 200 and data:
                w, h = int(headers.get("X-Width", 0)), int(headers.get("X-Height", 0))
                if w and h and len(data) == w * h * 3:
                    GLib.idle_add(self.show_frame, w, h, data)
            else:
                GLib.idle_add(self.show_frame, 0, 0, None)
            time.sleep(max(0.0, 1 / 12 - (time.monotonic() - started)))

    def show_frame(self, w, h, data):
        if data is None:
            self.picture.set_paintable(None)
            self.preview_empty.set_visible(True)
            return False
        texture = Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8, GLib.Bytes.new(data), w * 3)
        self.picture.set_paintable(texture)
        self.preview_empty.set_visible(False)
        return False


def main():
    app = Panel(open_pairing="--pair" in sys.argv)
    try:
        from gi.repository import GLibUnix
        GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (app.quit(), False)[1])
    except ImportError:
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (app.quit(), False)[1])
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
