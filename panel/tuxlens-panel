# gtk4-layer-shell must load before libwayland; from Python that means LD_PRELOAD + re-exec.
def _layer_shell_lib() -> str | None:
    for candidate in ("/usr/lib/libgtk4-layer-shell.so", "/usr/lib64/libgtk4-layer-shell.so",
                      "/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0"):
        if os.path.exists(candidate):
            return candidate
    name = ctypes.util.find_library("gtk4-layer-shell")
    return name


_LIB = _layer_shell_lib()
if _LIB and _LIB not in os.environ.get("LD_PRELOAD", "") and not os.environ.get("TUXLENS_NO_PRELOAD"):
    os.environ["LD_PRELOAD"] = (_LIB + " " + os.environ.get("LD_PRELOAD", "")).strip()
    os.execv(sys.executable, [sys.executable, os.path.abspath(sys.argv[0]), *sys.argv[1:]])

