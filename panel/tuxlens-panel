        self.picture.set_size_request(self.PREVIEW_W, self.PREVIEW_W * 9 // 16)
        overlay.set_child(self.picture)
        self.preview_empty = label(S["no_preview"], "preview-empty", xalign=0.5)
        self.preview_empty.set_halign(Gtk.Align.CENTER)
        self.preview_empty.set_valign(Gtk.Align.CENTER)
        overlay.add_overlay(self.preview_empty)
        self.preview_overlay = overlay
        body.append(overlay)
        self.stats = label("", "stats")
        self.stats.set_margin_top(6)
        body.append(self.stats)

        # camera
        sec = self.section(body, S["camera"], "camera", True)
        source_row = Gtk.Box(spacing=10, margin_bottom=8)
        source_row.add_css_class("row")
        source_row.append(label(S["source"], "muted", ellipsize=True))
        self.source_ids: list[str] = []
