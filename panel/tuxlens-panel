def label(text: str, css: str | None = None, xalign: float = 0.0, ellipsize: bool = False) -> Gtk.Label:
    lab = Gtk.Label(label=text, xalign=xalign)
    if css:
        for cls in css.split():
            lab.add_css_class(cls)
    if ellipsize:
        lab.set_ellipsize(Pango.EllipsizeMode.END)
        lab.set_hexpand(True)
    return lab


class Segmented(Gtk.Box):
    """Row of exclusive buttons (like a macOS segmented control)."""

    def __init__(self, options: list[tuple[str, str]], on_pick):
        super().__init__(spacing=3, homogeneous=True)
        self.add_css_class("seg")
        self.buttons: dict[str, Gtk.Button] = {}
        self.on_pick = on_pick
        for key, text in options:
            b = Gtk.Button(label=text)
            b.connect("clicked", lambda _b, k=key: self.on_pick(k))
            self.buttons[key] = b
            self.append(b)

    def set_active(self, key: str | None) -> None:
        for k, b in self.buttons.items():
            if k == key:
                b.add_css_class("active")
            else:
                b.remove_css_class("active")

    def set_available(self, keys: set[str] | None) -> None:
        for k, b in self.buttons.items():
            b.set_sensitive(keys is None or k in keys)


# ------------------------------------------------------------------------------------- panel
class Panel(Gtk.Application):
    WIDTH = 420
    PREVIEW_W = WIDTH - 32   # card padding; the texture is fetched at this size so it never widens the card

    def __init__(self, open_pairing: bool = False):
        super().__init__(application_id="io.github.tuxlens.panel", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.open_pairing = open_pairing
        self.window = None
        self.status: dict | None = None
        self.theme_id = None
        self.css_provider = Gtk.CssProvider()
        self._updating = False
        self._preview_running = False
        self._zoom_timer = 0

    # -- lifecycle --------------------------------------------------------------------------
    def do_activate(self):
        if self.window is not None:     # clicking the bar icon again closes it
            self.quit()
            return
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), self.css_provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        self.apply_theme(self.initial_theme())
        self.build_window()
        self.window.present()
        self.refresh()
        GLib.timeout_add(1000, self.refresh)
        self._preview_running = True
        threading.Thread(target=self.preview_loop, daemon=True).start()
        if self.open_pairing:
            self.toggle_pair()

    def do_shutdown(self):
        self._preview_running = False
        Gtk.Application.do_shutdown(self)

    def initial_theme(self) -> str:
        try:
            settings = api("GET", "/status")["settings"]
        except (OSError, KeyError, ValueError):
            return themes.DEFAULT_THEME
        use_language(settings.get("language"))
        return settings.get("theme", themes.DEFAULT_THEME)

    def apply_theme(self, theme_id: str) -> None:
        if theme_id == self.theme_id:
            return
        self.theme_id = theme_id
        self.css_provider.load_from_string(build_css(themes.load(theme_id)) + themes.extra_css())

    # -- window -----------------------------------------------------------------------------
    def build_window(self):
        win = Gtk.ApplicationWindow(application=self, title="TuxLens")
        win.add_css_class("tl")
        win.set_decorated(False)
        self.window = win
        if LayerShell is not None and LayerShell.is_supported():
            LayerShell.init_for_window(win)
            LayerShell.set_namespace(win, "tuxlens")
            LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)
            LayerShell.set_exclusive_zone(win, -1)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(win, edge, True)
        else:
            win.set_default_size(self.WIDTH + 40, 760)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)

        backdrop = Gtk.Box(hexpand=True, vexpand=True)
        win.set_child(backdrop)
        click = Gtk.GestureClick(button=0)
        click.connect("pressed", self.on_backdrop_click, backdrop)
        backdrop.add_controller(click)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, halign=Gtk.Align.END, valign=Gtk.Align.START,
                       hexpand=True)
        card.add_css_class("card")
        card.set_size_request(self.WIDTH, -1)
        margin = int(os.environ.get("TUXLENS_PANEL_MARGIN", "10"))
        card.set_margin_top(int(os.environ.get("TUXLENS_PANEL_TOP", "48")))
        card.set_margin_end(margin)
        backdrop.append(card)
        self.card = card

        # header
        header = Gtk.Box(spacing=10)
        icon = Gtk.Image.new_from_file(str(REPO / "web" / "icon.svg"))
        icon.set_pixel_size(34)
        header.append(icon)
        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        texts.append(label("TuxLens", "title"))
        sub = Gtk.Box()
        self.dot = Gtk.Box(valign=Gtk.Align.CENTER)
        self.dot.add_css_class("dot")
        sub.append(self.dot)
        self.subtitle = label("…", "subtitle", ellipsize=True)
        sub.append(self.subtitle)
        texts.append(sub)
        header.append(texts)
        self.camera_switch = Gtk.Switch(valign=Gtk.Align.CENTER, tooltip_text=S["camera_switch"])
        self.camera_switch.connect("state-set", lambda _s, on: (self.set({"camera_enabled": on})
                                                                if not self._updating else None, False)[1])
        header.append(self.camera_switch)
        close = Gtk.Button(icon_name="window-close-symbolic", valign=Gtk.Align.CENTER, tooltip_text=S["close"])
        close.connect("clicked", lambda _b: self.quit())
        header.append(close)
        card.append(header)

        # Everything below the header scrolls if the monitor is too short for the whole card.
        scroller = Gtk.ScrolledWindow(propagate_natural_height=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_max_content_height(self.max_body_height())
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        scroller.set_child(body)
        card.append(scroller)

        # pending pairing requests (accept / reject)
        self.requests_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=10, visible=False)
        body.append(self.requests_box)
        self._requests_key = None

        # preview
