        demand_row.append(demand_texts)
        self.on_demand = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.on_demand.connect("state-set", lambda _s, on: (self.set({"on_demand": on}) if not self._updating else None, False)[1])
        demand_row.append(self.on_demand)
        sec.append(demand_row)
        self.cameras = Segmented([(k, S[k]) for k in CAMERA_ORDER], lambda k: self.set({"camera": k}))
        sec.append(self.cameras)

        zoom_row = Gtk.Box(spacing=10, margin_top=8)
        zoom_row.add_css_class("row")
        zoom_row.append(label(S["zoom"], "muted"))
        self.zoom = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 10, 0.1)
        self.zoom.set_hexpand(True)
        self.zoom.set_draw_value(False)
        self.zoom.connect("value-changed", self.on_zoom)
        zoom_row.append(self.zoom)
        self.zoom_value = label("1.0×", "stats")
