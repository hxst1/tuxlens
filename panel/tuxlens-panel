# ------------------------------------------------------------------------------------- API
class UnixHTTP(http.client.HTTPConnection):
    def __init__(self, timeout: float = 2.0):
        super().__init__("localhost", timeout=timeout)

    def connect(self) -> None:
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(str(CONTROL_SOCKET))


def api(method: str, path: str, body: dict | None = None, raw: bool = False):
    conn = UnixHTTP()
    try:
        payload = json.dumps(body).encode() if body is not None else None
        conn.request(method, path, body=payload, headers={"Content-Type": "application/json"} if payload else {})
        resp = conn.getresponse()
        data = resp.read()
        if raw:
            return resp.status, dict(resp.getheaders()), data
        return json.loads(data) if data else {}
    finally:
        conn.close()


def api_async(method: str, path: str, body: dict | None = None, done=None) -> None:
    def work():
        try:
            result = api(method, path, body)
        except OSError:
            result = None
        if done:
            GLib.idle_add(done, result)
    threading.Thread(target=work, daemon=True).start()


