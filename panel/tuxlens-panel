"""TuxLens control panel: GTK4 + layer-shell glass card driven by the daemon's local API.

Everything the phone does is controlled from here; the phone only grants permissions.
Styling comes entirely from the active theme (themes/*.json) plus ~/.config/tuxlens/extra.css.
"""
from __future__ import annotations

import ctypes.util
import os
